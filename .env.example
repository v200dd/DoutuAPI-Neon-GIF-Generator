# Required: replace the empty value locally; never commit .env.
ADMIN_PASSWORD=
# Set to the actual public domain (HTTPS recommended), without a trailing slash.
DOUTU_PUBLIC_URL=http://127.0.0.1:8000
DOUTU_PORT=8000
DOUTU_BIND_IP=0.0.0.0
# Optional. Blank disables outbound third-party requests.
DOUTU_THIRD_PARTY_TOKEN=
# Confirm the text parameter against your provider documentation before enabling.
DOUTU_THIRD_PARTY_TEXT_PARAM=text
